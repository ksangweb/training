<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบบันทึกการอบรม - โรงเรียนบ้านพระพุทธ</title>
    
    <!-- ฝังภาพไอคอนเว็บไซต์ (Favicon) เป็นโลโก้โรงเรียน -->
    <link rel="icon" href="https://img1.pic.in.th/images/logoppp.png" type="image/png">
    
    <style>
        /* ลบขอบขาวรอบหน้าจอและตั้งค่าให้แสดงผลเต็มพื้นที่ 100% */
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden; /* ซ่อนแถบเลื่อนของหน้าหลัก GitHub */
            background-color: #e0c3fc;
        }
        
        /* ตั้งค่ากรอบ Iframe ให้เต็มจอไร้ขอบเขต */
        iframe {
            width: 100vw;
            height: 100vh;
            border: none;
            display: block;
        }
    </style>
</head>
